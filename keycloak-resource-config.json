  "policies": [
    {
      "name": "admin-access-policy",
      "description": "Allowing access to admin resource",
      "type": "role",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "fetchRoles": "true",
        "roles": "[{\"id\":\"admin\",\"required\":false}]"
      }
    },
    {
      "name": "demo-access-policy",
      "description": "Allowing access to demo resource",
      "type": "role",
