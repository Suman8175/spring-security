        "roles": "[{\"id\":\"admin\",\"required\":false},{\"id\":\"demo\",\"required\":false}]"
      }
    },
    {
      "name": "admin-permission",
      "description": "Allowing access to admin resource",
      "type": "scope",
      "logic": "POSITIVE",
      "decisionStrategy": "UNANIMOUS",
      "config": {
        "scopes": "[\"GET\",\"PUT\",\"POST\",\"DELETE\",\"PATCH\"]",
        "applyPolicies": "[\"admin-access-policy\"]"
      }
    },
    {
